{
  "name": "MEGA 1 - Content & Creative Engine (Aurra Hype / all brands)",
  "meta": { "ospyr": "18 sub-workflows: AI copy, images, Higgsfield video, ElevenLabs voice, HeyGen avatar, repurpose, SEO, schedule, multi-post, VIP drop, logging.", "requiredKeys": ["OpenAI","Higgsfield","ElevenLabs","HeyGen","Runway or Kling","Photoroom","Ideogram","Metricool","Instagram Graph","Facebook Graph","Google Drive","Notion","Slack","WhatsApp (AiSensy/WATI)"] },
  "active": false,
  "settings": {},
  "nodes": [
    { "id": "t1", "name": "1. Content request (webhook)", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [200, 200], "parameters": { "httpMethod": "POST", "path": "content-engine", "responseMode": "responseNode" } },
    { "id": "t2", "name": "2. Content calendar (9am)", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [200, 520], "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 9 * * *" } ] } } },
    { "id": "n1", "name": "3. AI caption + hooks (OpenAI)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 80], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "model", "value": "gpt-4o-mini" }, { "name": "messages", "value": "=[{\"role\":\"user\",\"content\":\"Write a caption + 3 hooks for {{$json.body.product}} ({{$json.body.brand}}).\"}]" } ] } }, "notes": "OpenAI key" },
    { "id": "n2", "name": "4. Product image (Photoroom)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 200], "parameters": { "method": "POST", "url": "https://image-api.photoroom.com/v2/edit", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "imageUrl", "value": "={{$json.body.image_url}}" } ] } }, "notes": "Photoroom API key" },
    { "id": "n3", "name": "5. Poster/text image (Ideogram)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 320], "parameters": { "method": "POST", "url": "https://api.ideogram.ai/generate", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "prompt", "value": "=Poster for {{$json.body.product}}" } ] } }, "notes": "Ideogram API key" },
    { "id": "n4", "name": "6. Image -> showcase video (Higgsfield)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [760, 200], "parameters": { "method": "POST", "url": "https://api.higgsfield.ai/v1/video/generate", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "image_url", "value": "={{$json.result_url}}" }, { "name": "mode", "value": "ugc_showcase" } ] } }, "notes": "Higgsfield API key (paid)" },
    { "id": "n5", "name": "7. Cinematic drop video (Kling/Runway)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 440], "parameters": { "method": "POST", "url": "https://api.klingai.com/v1/videos/text2video", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "prompt", "value": "=Cinematic hero film for {{$json.body.product}}" } ] } }, "notes": "Kling or Runway API key (paid)" },
    { "id": "n6", "name": "8. Voiceover (ElevenLabs)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [760, 440], "parameters": { "method": "POST", "url": "https://api.elevenlabs.io/v1/text-to-speech/{{$json.body.voice_id}}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "text", "value": "={{$json.body.script}}" }, { "name": "model_id", "value": "eleven_multilingual_v2" } ] } }, "notes": "ElevenLabs API key (xi-api-key header)" },
    { "id": "n7", "name": "9. Avatar presenter (HeyGen)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [760, 560], "parameters": { "method": "POST", "url": "https://api.heygen.com/v2/video/generate", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "script", "value": "={{$json.body.script}}" } ] } }, "notes": "HeyGen API key (paid)" },
    { "id": "n8", "name": "10. Repurpose to clips (Opus)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 560], "parameters": { "method": "POST", "url": "https://api.opus.pro/v1/clips", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "video_url", "value": "={{$json.body.long_video}}" } ] } }, "notes": "Opus Clip API key" },
    { "id": "n9", "name": "11. SEO blog (OpenAI)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 680], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "model", "value": "gpt-4o-mini" }, { "name": "messages", "value": "=[{\"role\":\"user\",\"content\":\"Write an SEO blog about {{$json.body.topic}}.\"}]" } ] } } },
    { "id": "n10", "name": "12. Hashtags + best time", "type": "n8n-nodes-base.set", "typeVersion": 2, "position": [760, 80], "parameters": { "values": { "string": [ { "name": "hashtags", "value": "=auto" }, { "name": "post_time", "value": "19:30" } ] } } },
