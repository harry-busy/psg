{
  "name": "MEGA 2 - Sales, Leads & CRM Engine (Loop In Events / Designomics corporate)",
  "meta": { "ospyr": "18 sub-workflows: capture, AI-qualify, route, instant reply, booking, AI proposal, email, follow-ups, deal stages, invoice, reminders, feedback, testimonial, upsell, AI voice follow-up, pipeline report.", "requiredKeys": ["OpenAI","ElevenLabs","HubSpot or Zoho CRM","Cal.com","Gmail/SMTP","Razorpay or Zoho Books","WhatsApp (AiSensy/WATI)","Telephony (Twilio/Exotel)"] },
  "active": false,
  "settings": {},
  "nodes": [
    { "id": "t1", "name": "1. New lead (webhook)", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [200, 240], "parameters": { "httpMethod": "POST", "path": "new-lead", "responseMode": "responseNode" } },
    { "id": "t2", "name": "2. Follow-up cron (daily)", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [200, 640], "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 10 * * *" } ] } } },
    { "id": "n1", "name": "3. AI qualify + score (OpenAI)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [460, 160], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "model", "value": "gpt-4o-mini" }, { "name": "messages", "value": "=[{\"role\":\"user\",\"content\":\"Score this lead 0-3 and extract intent/budget: {{JSON.stringify($json.body)}}\"}]" } ] } }, "notes": "OpenAI key" },
    { "id": "n2", "name": "4. Save to CRM (HubSpot)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [720, 160], "parameters": { "method": "POST", "url": "https://api.hubapi.com/crm/v3/objects/contacts", "sendBody": true }, "notes": "HubSpot/Zoho token" },
    { "id": "n3", "name": "5. Route by score (IF)", "type": "n8n-nodes-base.if", "typeVersion": 1, "position": [980, 160], "parameters": { "conditions": { "number": [ { "value1": "={{$json.score}}", "operation": "largerEqual", "value2": 2 } ] } } },
    { "id": "n4", "name": "6. Instant WhatsApp reply", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1240, 80], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true }, "notes": "WhatsApp key" },
    { "id": "n5", "name": "7. Send booking link (Cal.com)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1240, 200], "parameters": { "method": "POST", "url": "https://api.cal.com/v1/bookings", "sendBody": true }, "notes": "Cal.com key" },
    { "id": "n6", "name": "8. AI proposal (OpenAI)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1240, 320], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "sendBody": true, "bodyParameters": { "parameters": [ { "name": "model", "value": "gpt-4o-mini" }, { "name": "messages", "value": "=[{\"role\":\"user\",\"content\":\"Draft an event/gifting proposal for {{$json.body.name}}.\"}]" } ] } } },
    { "id": "n7", "name": "9. Send proposal email (Gmail)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1500, 320], "parameters": { "method": "POST", "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send", "sendBody": true } },
    { "id": "n8", "name": "10. Nurture reply (low score)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1240, 440], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true } },
    { "id": "n9", "name": "11. Follow-up D1/D3/D7", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [460, 640], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true } },
    { "id": "n10", "name": "12. Move deal stage (CRM)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [720, 640], "parameters": { "method": "PATCH", "url": "https://api.hubapi.com/crm/v3/objects/deals/{{$json.deal_id}}", "sendBody": true } },
    { "id": "n11", "name": "13. Create invoice (Razorpay)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [980, 640], "parameters": { "method": "POST", "url": "https://api.razorpay.com/v1/invoices", "sendBody": true }, "notes": "Razorpay/Zoho Books key" },
    { "id": "n12", "name": "14. Payment reminder (WA/SMS)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1240, 640], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true } },
    { "id": "n13", "name": "15. Post-event feedback form", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [460, 800], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true } },
    { "id": "n14", "name": "16. Testimonial request", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [720, 800], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true } },
    { "id": "n15", "name": "17. Upsell offer", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [980, 800], "parameters": { "method": "POST", "url": "https://backend.aisensy.com/campaign/t1/api", "sendBody": true } },
    { "id": "n16", "name": "18. AI voice follow-up (ElevenLabs)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1240, 800], "parameters": { "method": "POST", "url": "https://api.elevenlabs.io/v1/text-to-speech/{{$json.voice_id}}", "sendBody": true }, "notes": "ElevenLabs key + telephony (Twilio/Exotel) to place the call" },
    { "id": "n17", "name": "19. Weekly pipeline report (OpenAI)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [460, 960], "parameters": { "method": "POST", "url": "https://api.openai.com/v1/chat/completions", "sendBody": true } },
