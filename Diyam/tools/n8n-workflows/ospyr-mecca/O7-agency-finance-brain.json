    {
      "parameters": {"jsCode": "// ⑧⑨⑩⑬ chase ladder + Friday aging\nconst d=new Date();const ym=d.toISOString().slice(0,7);const day=d.getDate();const isFri=d.getDay()===5;\nconst unpaid=items.map(i=>i.json).filter(r=>r.Status==='Active'&&r.LastPaid!==ym);\nlet out=[];\nfor(const r of unpaid){const over=day-Number(r.DueDay||1);\nif(over===3)out.push(`• D+3 gentle: ${r.Client} ₹${r.Amount}`);\nif(over===7)out.push(`• D+7 firm: ${r.Client} — mention pause of deliverables`);\nif(over>=14)out.push(`• 🔴 D+14 CALL: ${r.Client} — personal call today`);}\nif(isFri&&unpaid.length)out.push(`📊 Aging: ${unpaid.length} unpaid — ${unpaid.map(r=>r.Client).join(', ')}`);\nreturn out.length?[{json:{text:'💰 CHASE TODAY:\\n'+out.join('\\n')}}]:[];"},
      "id": "ch3", "name": "CH3 chase ladder ⑧-⑩⑬", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [360, 100]
