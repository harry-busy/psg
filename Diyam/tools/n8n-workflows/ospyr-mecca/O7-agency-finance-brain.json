    {"parameters": {"method": "POST", "url": "https://api.razorpay.com/v1/payment_links", "authentication": "genericCredentialType", "genericAuthType": "httpBasicAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={ \"amount\": {{ Number($json.Amount)*100 }}, \"currency\": \"INR\", \"description\": {{ JSON.stringify('Ospyr retainer — '+$json.Client+' — '+$now.toISO().slice(0,7)) }} }", "options": {"response": {"response": {"neverError": true}}}}, "id": "r4", "name": "R4 Razorpay link ②", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [540, -180], "credentials": {"httpBasicAuth": {"id": "REPLACE", "name": "Razorpay Keys"}}},
    {"parameters": {"method": "POST", "url": "=https://www.zohoapis.in/books/v3/invoices?organization_id={{$env.ZB_ORG_ID}}", "authentication": "genericCredentialType", "genericAuthType": "oAuth2Api", "sendBody": true, "specifyBody": "json", "jsonBody": "={ \"customer_name\": {{ JSON.stringify($('R3 due this month ①⑦').item.json.Client) }}, \"line_items\": [{ \"name\": \"Monthly growth retainer\", \"rate\": {{ Number($('R3 due this month ①⑦').item.json.Amount) }}, \"quantity\": 1 }] }", "options": {"response": {"response": {"neverError": true}}}}, "id": "r5", "name": "R5 Zoho invoice ③", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [540, -60], "credentials": {"oAuth2Api": {"id": "REPLACE", "name": "Zoho Books OAuth"}}},
