    {"parameters": {"jsCode": "return items.filter(i=>i.json.Amount&&(i.json.Synced||'')!=='yes').slice(0,20).map(i=>({json:i.json}));"}, "id": "e3", "name": "E3 unsynced", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [380, 1060]},
    {"parameters": {"method": "POST", "url": "=https://www.zohoapis.in/books/v3/invoices?organization_id={{$env.ZB_ORG_ID}}", "authentication": "genericCredentialType", "genericAuthType": "oAuth2Api", "sendBody": true, "specifyBody": "json", "jsonBody": "={ \"customer_name\": {{ JSON.stringify($json.Customer||'Walk-in') }}, \"line_items\": [{ \"name\": {{ JSON.stringify($json.Item||'Jewellery') }}, \"rate\": {{ Number(String($json.Amount).replace(/[^0-9.]/g,'')) }}, \"quantity\": {{ Number($json.Qty||1) }}, \"hsn_or_sac\": \"7113\" }], \"reference_number\": {{ JSON.stringify(String($json.OrderID)) }} }", "options": {"response": {"response": {"neverError": true}}}}, "id": "e4", "name": "E4 Zoho invoice", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [560, 1060], "credentials": {"oAuth2Api": {"id": "REPLACE", "name": "Zoho Books OAuth"}}},
    {"parameters": {"operation": "update", "documentId": {"__rl": true, "value": "REPLACE_SHEET_ID", "mode": "id"}, "sheetName": {"__rl": true, "value": "Orders", "mode": "name"}, "columns": {"mappingMode": "defineBelow", "value": {"row_number": "={{ $('E3 unsynced').item.json.row_number }}", "Synced": "yes"}, "matchingColumns": ["row_number"]}, "options": {}}, "id": "e5", "name": "E5 mark synced", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [740, 1060], "credentials": {"googleSheetsOAuth2Api": {"id": "REPLACE", "name": "Google Sheets"}}},
    {"parameters": {"url": "=https://api.razorpay.com/v1/payments?from={{ Math.floor(new Date(new Date().toISOString().slice(0,10)).getTime()/1000) }}&count=100", "authentication": "genericCredentialType", "genericAuthType": "httpBasicAuth", "options": {"response": {"response": {"neverError": true}}}}, "id": "e6", "name": "E6 Razorpay today", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [380, 1180], "credentials": {"httpBasicAuth": {"id": "REPLACE", "name": "Razorpay Keys"}}},
    {"parameters": {"jsCode": "const t=new Date().toISOString().slice(0,10);\nconst orders=$('E2 read orders').all().map(i=>i.json);\nconst today=orders.filter(r=>(r.Date||'').startsWith(t));\nconst prepaid=today.filter(r=>r.Payment!=='COD');\nconst oSum=prepaid.reduce((s,r)=>s+(Number(String(r.Amount).replace(/[^0-9.]/g,''))||0),0);\nconst pSum=(($json.items)||[]).filter(p=>p.status==='captured').reduce((s,p)=>s+p.amount/100,0);\nconst diff=Math.round(oSum-pSum);\nconst rev=today.reduce((s,r)=>s+(Number(String(r.Amount).replace(/[^0-9.]/g,''))||0),0);\nreturn [{ json: { text: `🌙 NIGHT REPORT — ${t}\\n🛍️ Orders today: ${today.length} · ₹${rev.toLocaleString('en-IN')}\\n${Math.abs(diff)<=1?'✅ Recon OK':'🔴 RECON diff ₹'+diff.toLocaleString('en-IN')+' (prepaid ₹'+oSum.toLocaleString('en-IN')+' vs captured ₹'+pSum.toLocaleString('en-IN')+')'}\\n📚 Zoho: unsynced pushed\\n💾 Backup: done` } }];"}, "id": "e7", "name": "E7 recon + digest", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [560, 1180]},
    {"parameters": {"operation": "copy", "fileId": {"__rl": true, "value": "REPLACE_SHEET_ID", "mode": "id"}, "name": "=Backup-{{ $now.toISO().slice(0,10) }}-master", "sameFolder": false, "folderId": {"__rl": true, "value": "REPLACE_BACKUP_FOLDER_ID", "mode": "id"}, "options": {}}, "id": "e8", "name": "E8 Drive backup", "type": "n8n-nodes-base.googleDrive", "typeVersion": 3, "position": [740, 1180], "credentials": {"googleDriveOAuth2Api": {"id": "REPLACE", "name": "Google Drive"}}},
    {"parameters": {"operation": "sendMessage", "chatId": "={{$env.TG_OWNER_CHAT_ID}}", "text": "={{ $('E7 recon + digest').item.json.text }}", "additionalFields": {}}, "id": "e9", "name": "E9 night digest", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [920, 1180], "credentials": {"telegramApi": {"id": "REPLACE", "name": "Jeweller Bot"}}}
