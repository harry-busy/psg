# ─────────────────────────────────────────────────────────────
# Ospyr OS — environment template.
# Copy to .env.local and fill in. NEVER commit .env.local.
# All AI/provider keys are used ONLY in server-side API routes
# (app/api/**), never shipped to the browser.
# ─────────────────────────────────────────────────────────────

# Groq — text + vision + speech (free). https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Image provider: pollinations (free, no key) | cloudflare | together | huggingface | fal | replicate | gemini
# Video provider: fal | replicate
IMAGE_PROVIDER=pollinations
VIDEO_PROVIDER=replicate

# Extra FREE image/video providers — all optional, add any you have a free key for.
CF_ACCOUNT_ID=
CF_API_TOKEN=            # Cloudflare Workers AI (~100k req/day free)
HF_TOKEN=               # Hugging Face Inference
TOGETHER_API_KEY=       # Together AI (FLUX free tier)
FAL_KEY=                # fal.ai (free credits — best for video)
REPLICATE_API_TOKEN=    # Replicate — video (LTX/Wan) + FLUX image. https://replicate.com/account/api-tokens
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_VERSION= # optional: pin a specific model version for video
GEMINI_API_KEY=         # https://aistudio.google.com/app/apikey
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
HIGGSFIELD_API_KEY=

# Email Concierge (free tiers) — pick one. EMAIL_PROVIDER: brevo | resend | n8n
EMAIL_PROVIDER=brevo
EMAIL_FROM=
EMAIL_FROM_NAME=
BREVO_API_KEY=          # 300 emails/day free
RESEND_API_KEY=         # 3,000/mo free
N8N_EMAIL_WEBHOOK=

# ── Supabase (real backend for both sectors) ──────────────────
# Create a free project, run supabase/schema.sql, then paste:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only; powers the n8n ingest webhook

# Secret the n8n MEGA engines send in `x-ingest-secret` to POST /api/ingest/{workspace}
INGEST_SECRET=
